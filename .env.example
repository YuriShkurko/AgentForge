# Root example for AgentForge development.
# Never commit a real .env with secrets.

# Generated/demo app backend settings live in:
# - templates/fastapi-react/backend/.env.example
# - examples/hybrid-scoring-demo/backend/.env.example

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/scoring_demo
VITE_API_URL=http://localhost:8000

# Default no-key agent mode
AGENT_PROVIDER=scripted

# Optional live chat mode for generated app backend:
# AGENT_PROVIDER=openai
# OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
