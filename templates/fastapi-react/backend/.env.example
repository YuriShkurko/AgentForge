# Copy to .env and fill in values for local development.
# Tests use SQLite in-memory — .env is only needed for running the live server.

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/hybrid_scoring_demo

# Optional
LOG_LEVEL=info

# Agent mode
# Default no-key deterministic provider:
AGENT_PROVIDER=scripted
# Optional live chat provider. Requires OPENAI_API_KEY and is never used by tests unless mocked.
# AGENT_PROVIDER=openai
# OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
